---
// Page de remerciement après don, bilingue (/don-merci en FR, /en/don-merci en EN).
import Layout from '../layouts/Layout.astro';
import { localeFromPath, t } from '../i18n.js';
const locale = localeFromPath(Astro.url.pathname);
const homeHref = locale === 'fr' ? '/' : '/en/';
const prayerHref = locale === 'fr' ? '/mur-de-priere' : '/en/mur-de-priere';
---
<Layout title={`CMN — ${t(locale, 'Merci pour ton don')}`}>
  <section class="fd">
    <div class="wrap" style="max-width:640px;text-align:center;padding:64px 0">
      <div style="font-size:54px">🙏</div>
      <h1 style="font-size:clamp(26px,4vw,38px);color:var(--char);margin:14px 0 10px">{t(locale, 'Merci du fond du cœur')}</h1>
      <p style="color:var(--muted);font-size:17px;line-height:1.6">
        {t(locale, 'Ton don a bien été pris en compte. Un reçu te sera envoyé par e-mail par notre prestataire de paiement sécurisé. Grâce à toi, la mission continue : évangélisation, formation des disciples et projets humanitaires sur le terrain.')}
      </p>
      <blockquote style="margin:26px auto;max-width:520px;font-style:italic;color:var(--char)">
        {t(locale, "« Que chacun donne comme il l'a résolu en son cœur, sans tristesse ni contrainte ; car Dieu aime celui qui donne avec joie. » — 2 Corinthiens 9:7")}
      </blockquote>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:22px">
        <a class="btn btn-gold" href={homeHref}>{t(locale, "Retour à l'accueil")}</a>
        <a class="btn btn-ghost" href={prayerHref}>{t(locale, 'Déposer une prière')}</a>
      </div>
    </div>
  </section>
</Layout>
