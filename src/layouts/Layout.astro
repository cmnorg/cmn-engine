---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GabyWidget from '../components/GabyWidget.astro';
import { sbGet } from '../sb.js';
import { localeFromPath, t, LANGS, barePath, localizedHref, STANDALONE } from '../i18n.js';
const {
  title = 'CMN — Christians on Mission for Nations',
  description = "Christians on Mission for Nations (CMN) : mouvement chrétien international de foi et d'action — évangélisation, formation, projets humanitaires et partenariats pour transformer les vies et les nations.",
} = Astro.props;
const locale = localeFromPath(Astro.url.pathname);
const bare = barePath(Astro.url.pathname);
let settings = null;
try {
  const { data } = await sbGet('cdn/stories/settings', { version: 'draft', language: locale });
  settings = data?.story?.content || null;
} catch (e) { settings = null; }

// ===== SEO =====
const SITE = (Astro.site && String(Astro.site.href).replace(/\/$/, '')) || 'https://cmn-engine.pages.dev';
const canonical = SITE + Astro.url.pathname;
const ogImage = settings?.og_image?.filename || settings?.logo?.filename || '';
const ogLocale = { fr: 'fr_FR', en: 'en_US', es: 'es_ES', id: 'id_ID', zh: 'zh_CN' }[locale] || 'fr_FR';
const slug0 = (bare || '').split('/')[0];
const showAlt = STANDALONE.indexOf(slug0) === -1; // hreflang seulement pour les pages localisées
const alternates = showAlt
  ? LANGS.map((Lg) => ({ code: Lg.code, href: SITE + localizedHref(bare, Lg.code) }))
  : [];
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#C0982E" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={SITE + '/'} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CMN — Christians on Mission for Nations" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Christians on Mission for Nations',
      alternateName: 'CMN',
      url: SITE + '/',
      logo: ogImage || undefined,
      description: description,
    })} />
    <script is:inline>
      // Applique le thème AVANT le rendu (évite tout clignotement).
      (function () {
        try {
          // Clair par défaut (comme la version statique) ; le sombre n'est appliqué que si l'utilisateur l'a choisi.
          var t = localStorage.getItem('cmn_theme');
          if (t !== 'dark' && t !== 'light') t = 'light';
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Header settings={settings} />
    <slot />
    <section class="nlband">
      <div class="wrap nlwrap">
        <div class="nltext">
          <strong>{t(locale, 'Restez informé de la mission')}</strong>
          <span>{t(locale, 'Nouvelles du terrain, prières exaucées et temps forts — directement dans votre boîte mail.')}</span>
        </div>
        <form class="nlform" id="nlForm"
          data-lang={locale}
          data-ok={t(locale, "Merci ! Ton inscription à la newsletter est bien enregistrée.")}
          data-invalid={t(locale, 'Indique une adresse e-mail valide.')}
          data-consent={t(locale, 'Merci de cocher la case de consentement.')}
          data-err={t(locale, 'Une erreur est survenue. Réessaie dans un instant.')}>
          <input type="text" name="website" class="pw-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="email" id="nlEmail" placeholder={t(locale, 'Votre adresse email')} aria-label={t(locale, 'Votre adresse email')} required />
          <button class="btn btn-gold" type="submit">{t(locale, "S'inscrire")}</button>
        </form>
      </div>
      <div class="wrap">
        <label class="nlconsent"><input type="checkbox" id="nlConsent" /> <span>{t(locale, "J'accepte de recevoir la newsletter de CMN et je peux me désinscrire à tout moment (voir la politique de confidentialité).")}</span></label>
        <p id="nlMsg" role="status" aria-live="polite" style="margin:8px 0 0;font-size:13px;font-weight:600"></p>
      </div>
    </section>
    <Footer settings={settings} />
    <GabyWidget />
    <script define:vars={{ cc: { text: t(locale, 'Ce site utilise uniquement des cookies techniques nécessaires à son fonctionnement. Aucun cookie publicitaire.'), accept: t(locale, "J'accepte"), refuse: t(locale, 'Refuser'), more: t(locale, 'En savoir plus') } }}>
      // Bandeau de consentement cookies (affiché une seule fois, choix mémorisé 1 an).
      (function () {
        function getC(n) { return (document.cookie.match('(?:^|; )' + n + '=([^;]*)') || [])[1]; }
        if (getC('cmn_cookie_consent')) return;
        function setC(v) { try { document.cookie = 'cmn_cookie_consent=' + v + ';path=/;max-age=31536000;SameSite=Lax'; } catch (e) {} }
        var bar = document.createElement('div');
        bar.setAttribute('role', 'dialog'); bar.setAttribute('aria-label', 'Cookies');
        bar.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:1000;max-width:760px;margin:0 auto;background:#fff;color:#2C2C2A;border:1px solid #e6e4dc;border-radius:14px;box-shadow:0 14px 40px rgba(30,26,16,.18);padding:14px 16px;display:flex;gap:12px;align-items:center;flex-wrap:wrap;font-size:14px';
        var txt = document.createElement('div'); txt.style.cssText = 'flex:1 1 260px;line-height:1.5';
        txt.innerHTML = cc.text + ' <a href="/cookies" style="color:#A6791A;text-decoration:underline">' + cc.more + '</a>';
        var actions = document.createElement('div'); actions.style.cssText = 'display:flex;gap:8px;flex:0 0 auto';
        var acc = document.createElement('button'); acc.type = 'button'; acc.textContent = cc.accept;
        acc.style.cssText = 'background:#C0982E;color:#2C2C2A;border:none;border-radius:10px;padding:10px 16px;font-weight:600;cursor:pointer';
        var ref = document.createElement('button'); ref.type = 'button'; ref.textContent = cc.refuse;
        ref.style.cssText = 'background:transparent;color:#2C2C2A;border:1.5px solid #cfcdc4;border-radius:10px;padding:10px 16px;font-weight:600;cursor:pointer';
        function done(v) { setC(v); if (bar.parentNode) bar.parentNode.removeChild(bar); }
        acc.addEventListener('click', function () { done('accepted'); });
        ref.addEventListener('click', function () { done('essential'); });
        actions.appendChild(acc); actions.appendChild(ref);
        bar.appendChild(txt); bar.appendChild(actions);
        document.body.appendChild(bar);
      })();
    </script>
    <script is:inline>
      // Inscription newsletter : validation + consentement, envoi vers /api/newsletter.
      (function () {
        var f = document.getElementById('nlForm');
        if (!f) return;
        var email = document.getElementById('nlEmail');
        var consent = document.getElementById('nlConsent');
        var msg = document.getElementById('nlMsg');
        var EMAIL_RE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/;
        function show(t, color) { if (msg) { msg.textContent = t; msg.style.color = color; } }
        f.addEventListener('submit', function (e) {
          e.preventDefault();
          var v = (email.value || '').trim();
          email.style.borderColor = '';
          if (!EMAIL_RE.test(v)) { show(f.dataset.invalid, '#c0392b'); email.style.borderColor = '#c0392b'; email.focus(); return; }
          if (!consent.checked) { show(f.dataset.consent, '#c0392b'); return; }
          show('…', '#6f6e68');
          var btn = f.querySelector('button[type=submit]'); if (btn) btn.disabled = true;
          fetch('/api/newsletter', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: v, consent: true, lang: f.dataset.lang || '', website: (f.website ? f.website.value : '') })
          }).then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
            .then(function (res) {
              if (btn) btn.disabled = false;
              if (res.ok) { show(f.dataset.ok, '#1a7f37'); f.reset(); }
              else if (res.d && res.d.error === 'invalid_email') { show(f.dataset.invalid, '#c0392b'); email.style.borderColor = '#c0392b'; }
              else if (res.d && res.d.error === 'invalid_domain') { show(f.dataset.invalid, '#c0392b'); email.style.borderColor = '#c0392b'; }
              else if (res.d && res.d.error === 'consent_required') { show(f.dataset.consent, '#c0392b'); }
              else { show(f.dataset.err, '#c0392b'); }
            }).catch(function () { if (btn) btn.disabled = false; show(f.dataset.err, '#c0392b'); });
        });
      })();
    </script>
    <script is:inline>
      // Nettoyage automatique : on supprime tout ancien service worker + cache (qui servaient
      // d'anciennes versions), et on recharge UNE seule fois pour afficher la version fraîche.
      (function () {
        if (!('serviceWorker' in navigator)) return;
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          var had = regs.length > 0;
          regs.forEach(function (r) { r.unregister(); });
          if (window.caches && caches.keys) {
            caches.keys().then(function (keys) { keys.forEach(function (k) { caches.delete(k); }); }).catch(function () {});
          }
          var done = false;
          try { done = sessionStorage.getItem('cmn_sw_cleared') === '1'; } catch (e) {}
          if (had && !done) {
            try { sessionStorage.setItem('cmn_sw_cleared', '1'); } catch (e) {}
            location.reload();
          }
        }).catch(function () {});
      })();
    </script>
    <script is:inline>
      // 1) Choix manuel de langue : on mémorise dans un cookie (respecté par la détection auto).
      (function () {
        var ls = document.getElementById('langSel');
        if (ls) ls.addEventListener('change', function () {
          var opt = ls.options[ls.selectedIndex];
          var lang = opt ? opt.getAttribute('data-lang') : '';
          if (lang) document.cookie = 'cmn_lang=' + lang + ';path=/;max-age=31536000;SameSite=Lax';
          if (ls.value) window.location.href = ls.value;
        });
      })();

      // 2) Pré-remplissage de l'indicatif téléphonique selon le pays du visiteur.
      (function () {
        if (!document.querySelector('input[type="tel"]')) return;
        var DIAL = {
          FR:'+33', BE:'+32', CH:'+41', LU:'+352', MC:'+377', CA:'+1', HT:'+509',
          CI:'+225', SN:'+221', ML:'+223', BF:'+226', NE:'+227', TG:'+228', BJ:'+229',
          GA:'+241', CG:'+242', CD:'+243', CM:'+237', TD:'+235', GN:'+224', MG:'+261',
          MU:'+230', KM:'+269',
          // DOM-TOM français
          GP:'+590', MQ:'+596', RE:'+262', GF:'+594', YT:'+262', PM:'+508',
          BL:'+590', MF:'+590', WF:'+681', PF:'+689', NC:'+687',
          ID:'+62',
          ES:'+34', MX:'+52', AR:'+54', CO:'+57', PE:'+51', VE:'+58', CL:'+56', EC:'+593',
          GT:'+502', CU:'+53', BO:'+591', DO:'+1', HN:'+504', PY:'+595', SV:'+503', NI:'+505',
          CR:'+506', PA:'+507', UY:'+598', PR:'+1',
          CN:'+86', TW:'+886', HK:'+852', MO:'+853', SG:'+65',
          US:'+1', GB:'+44', AU:'+61', NZ:'+64', IE:'+353', ZA:'+27', NG:'+234', KE:'+254',
          GH:'+233', IN:'+91', PH:'+63', DE:'+49', IT:'+39', PT:'+351', NL:'+31', BR:'+55'
        };
        fetch('/api/geo').then(function (r) { return r.json(); }).then(function (d) {
          var dial = DIAL[(d && d.country) || ''];
          if (!dial) return;
          document.querySelectorAll('input[type="tel"]').forEach(function (inp) {
            if (!inp.value) inp.value = dial + ' ';
          });
        }).catch(function () {});
      })();
    </script>
    <script is:inline>
      (function () {
        var btns = document.querySelectorAll('.theme-btn');
        function refresh() {
          var d = document.documentElement.getAttribute('data-theme') === 'dark';
          btns.forEach(function (b) {
            var ic = b.querySelector('.ti'); if (ic) ic.textContent = d ? '☀️' : '🌙';
            b.setAttribute('aria-pressed', d ? 'true' : 'false');
          });
        }
        refresh();
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            var d = document.documentElement.getAttribute('data-theme') === 'dark';
            var next = d ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('cmn_theme', next); } catch (e) {}
            refresh();
          });
        });
      })();
    </script>
  </body>
</html>
